# StudyDebt Frontend Configuration
# ----------------------------------------------------
# Base URL path for GitHub Pages deployment (default is /studydebt/)
VITE_BASE_PATH=/studydebt/

# Optional Remote AI Backend API URL (e.g. https://api.studydebt.example.com)
# When developing locally, defaults to http://localhost:8000 when empty.
# In production on GitHub Pages, if empty, StudyDebt runs with its built-in client-side educational engine.
VITE_API_URL=
